# ============================================================================
# GBStudio Automation Hub - Environment Variables
# ============================================================================
# Copy this file to .env and update with your actual values
#
# Usage:
#   cp .env.example .env
#   Edit .env with your specific paths and settings
#

# ============================================================================
# Aseprite MCP Configuration
# ============================================================================

# Path to your local Aseprite binary installation
#
# macOS (App Store/DMG install):
ASEPRITE_PATH=/Applications/Aseprite.app/Contents/MacOS/aseprite
#
# macOS (Homebrew install):
# ASEPRITE_PATH=/usr/local/bin/aseprite
#
# Linux:
# ASEPRITE_PATH=/usr/bin/aseprite
#
# Windows (WSL):
# ASEPRITE_PATH=/mnt/c/Program Files/Aseprite/Aseprite.exe

# Aseprite MCP service URL (for internal service communication)
ASEPRITE_MCP_URL=http://aseprite-mcp:8189

# Aseprite MCP request timeout in seconds
ASEPRITE_MCP_TIMEOUT=300

# ============================================================================
# General Configuration
# ============================================================================

# Environment mode: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Neo4j Configuration
# ============================================================================

# Neo4j connection URI
# For Docker: Use service name as hostname
NEO4J_URI=bolt://neo4j:7687

# For local development (not using Docker):
# NEO4J_URI=bolt://localhost:7687

# Neo4j authentication
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Neo4j database name (default: neo4j)
NEO4J_DATABASE=neo4j

# Neo4j Browser UI (for manual queries and visualization)
# Access at: http://localhost:7474
# Username: neo4j
# Password: password123

# ============================================================================
# Optional: Steam/Aseprite Installation
# ============================================================================
# If you want to install Aseprite from Steam within the container,
# provide these credentials. NOT RECOMMENDED - prefer local binary mount.
#
# WARNING: Do not commit these values. Use docker secrets or --env-file
#
# STEAM_USERNAME=your_steam_username
# STEAM_PASSWORD=your_steam_password
# STEAM_GUARD_CODE=XXXXX
# STEAM_APPID=431730
# STEAM_INSTALL_DIR=/opt/steamapps
