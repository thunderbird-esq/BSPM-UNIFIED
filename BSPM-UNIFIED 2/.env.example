# GBStudio Automation Hub - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=gbstudio
POSTGRES_PASSWORD=gbstudio_password_change_me
POSTGRES_DB=gbstudio_hub

# Database Connection (for application use)
DATABASE_URL=postgresql+asyncpg://gbstudio:gbstudio_password_change_me@postgres:5432/gbstudio_hub
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# Redis Cache
# ============================================================================
REDIS_PASSWORD=redis_password_change_me
REDIS_URL=redis://:redis_password_change_me@redis:6379/0
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# API Keys (if needed)
# ============================================================================
# API_KEY_SECRET=your_secret_key_here
