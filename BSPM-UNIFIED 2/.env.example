# ============================================================================
# GBStudio Automation Hub - Environment Variables
# ============================================================================
# Copy this file to .env and customize the values for your environment
# All GBSTUDIO_* variables override defaults in Settings class (main.py)
# ============================================================================

# ----------------------------------------------------------------------------
# General Application Settings
# ----------------------------------------------------------------------------

# Application environment (development or production)
# Affects security settings and logging
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------

# Allowed origins for CORS (comma-separated list)
# Example: http://localhost:8000,http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ----------------------------------------------------------------------------
# Service URLs (GBSTUDIO_ prefix)
# ----------------------------------------------------------------------------

# Ollama API endpoints
GBSTUDIO_OLLAMA_API_URL=http://ollama:11434/api/generate
GBSTUDIO_OLLAMA_EMBEDDINGS_URL=http://ollama:11434/api/embeddings
GBSTUDIO_OLLAMA_TAGS_URL=http://ollama:11434/api/tags

# ComfyUI API endpoint
GBSTUDIO_COMFYUI_API_URL=http://comfyui:8188

# ----------------------------------------------------------------------------
# File System Paths (GBSTUDIO_ prefix)
# ----------------------------------------------------------------------------

# Project files directory (must exist or will be created)
GBSTUDIO_PROJECT_FILES_PATH=/app/project_files

# ComfyUI workflow template
GBSTUDIO_WORKFLOW_TEMPLATE_PATH=/workflows/workflow_pixel_art.json

# Temporary outputs directory
GBSTUDIO_TEMP_OUTPUTS_PATH=/app/temp_outputs

# Vector store path (FAISS knowledge base)
GBSTUDIO_VECTORSTORE_PATH=/app/vectorstore

# Agent conversation memory path
GBSTUDIO_AGENT_MEMORY_PATH=/app/agent_memory

# GBStudio project file path
GBSTUDIO_GBSTUDIO_PROJECT_PATH=/app/project_files/MyGBCGame.gbsproj

# Project documentation directory (for knowledge base)
GBSTUDIO_PROJECT_DOCS_DIR=/app/project_docs

# ----------------------------------------------------------------------------
# AI Model Configuration (GBSTUDIO_ prefix)
# ----------------------------------------------------------------------------

# Ollama model for PM agent (project manager)
GBSTUDIO_PM_MODEL=llama3

# Ollama embedding model for knowledge base
GBSTUDIO_EMBEDDING_MODEL=nomic-embed-text

# Default timeout for Ollama requests (seconds)
GBSTUDIO_DEFAULT_TIMEOUT=90

# ----------------------------------------------------------------------------
# Sprite Generation Parameters (GBSTUDIO_ prefix)
# ----------------------------------------------------------------------------

# Sprite dimensions (Game Boy Color standard)
GBSTUDIO_SPRITE_WIDTH=32
GBSTUDIO_SPRITE_HEIGHT=32

# Number of animation frames
GBSTUDIO_NUM_FRAMES=8

# Maximum time for sprite generation (seconds)
GBSTUDIO_GENERATION_TIMEOUT=360

# ----------------------------------------------------------------------------
# Task Queue Configuration
# ----------------------------------------------------------------------------

# Maximum concurrent tasks (recommended: 1 for Intel Mac CPU generation)
# Higher values can be used on more powerful hardware
TASK_QUEUE_MAX_CONCURRENT=1

# Maximum execution time per task (seconds)
TASK_QUEUE_MAX_EXECUTION_TIME=600

# Enable resource monitoring (true/false)
TASK_QUEUE_ENABLE_MONITORING=true

# Resource thresholds for task queue pausing
TASK_QUEUE_CPU_THRESHOLD=95.0
TASK_QUEUE_MEMORY_THRESHOLD=85.0
TASK_QUEUE_DISK_THRESHOLD=95.0

# Resource check interval (seconds)
TASK_QUEUE_CHECK_INTERVAL=5.0

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log directory
LOG_DIR=/app/logs

# Log file rotation - max file size in bytes (10485760 = 10MB)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# API Server Configuration
# ----------------------------------------------------------------------------

# Server host (usually 0.0.0.0 for Docker)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8000

# Number of Uvicorn workers
SERVER_WORKERS=2

# Uvicorn log level
SERVER_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# API key for authentication (generate a secure random key)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# Rate limiting - requests per minute per IP
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------------------
# Health Check Settings
# ----------------------------------------------------------------------------

# Timeout for health check requests to external services (seconds)
HEALTH_CHECK_TIMEOUT=3

# ----------------------------------------------------------------------------
# Circuit Breaker Settings
# ----------------------------------------------------------------------------

# Number of failures before circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Number of successes to close circuit
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Circuit timeout in seconds
CIRCUIT_BREAKER_TIMEOUT=60

# ----------------------------------------------------------------------------
# Retry Logic Settings
# ----------------------------------------------------------------------------

# Maximum retry attempts for failed requests
RETRY_MAX_ATTEMPTS=3

# Base delay for exponential backoff (seconds)
RETRY_BASE_DELAY=1.0

# Maximum delay between retries (seconds)
RETRY_MAX_DELAY=10.0

# ----------------------------------------------------------------------------
# ComfyUI Workflow Settings
# ----------------------------------------------------------------------------

# ComfyUI polling interval (seconds)
COMFYUI_POLL_INTERVAL=2

# ComfyUI execution timeout (seconds)
COMFYUI_EXECUTION_TIMEOUT=360

# ComfyUI frame output node range
COMFYUI_FRAME_START_NODE=9
COMFYUI_FRAME_END_NODE=17

# ComfyUI preview node ID
COMFYUI_PREVIEW_NODE=18

# ----------------------------------------------------------------------------
# Database / Storage (if applicable)
# ----------------------------------------------------------------------------

# Redis URL (if using Redis for caching/sessions)
# REDIS_URL=redis://localhost:6379/0

# PostgreSQL connection (if using database)
# DATABASE_URL=postgresql://user:password@localhost:5432/gbstudio_hub

# ----------------------------------------------------------------------------
# Monitoring & Metrics
# ----------------------------------------------------------------------------

# Enable Prometheus metrics endpoint (true/false)
ENABLE_METRICS=true

# Metrics port (if different from main server)
# METRICS_PORT=9090

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Enable debug mode (shows detailed error traces)
DEBUG=false

# Enable hot reload for development
# HOT_RELOAD=true

# ----------------------------------------------------------------------------
# Docker Specific
# ----------------------------------------------------------------------------

# Docker network name (for inter-container communication)
# DOCKER_NETWORK=gbstudio_network

# Docker compose project name
# COMPOSE_PROJECT_NAME=gbstudio-automation-hub

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable style preset auto-detection
ENABLE_PRESET_AUTO_DETECTION=true

# Enable batch generation
ENABLE_BATCH_GENERATION=true

# Enable knowledge base admin UI
ENABLE_KB_ADMIN=true

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Variables with GBSTUDIO_ prefix are parsed by the Settings class
# 2. Boolean values should be: true/false (lowercase)
# 3. List values should be comma-separated with no spaces
# 4. All paths should be absolute paths
# 5. Timeouts are in seconds
# 6. Generate secure random keys for production use
# 7. Adjust resource limits based on your hardware capabilities
# ============================================================================
