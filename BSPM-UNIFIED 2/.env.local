# Local Development Configuration (No Docker)
# Override Docker-specific settings to run natively

# Service URLs - Use localhost instead of Docker service names
GBSTUDIO_OLLAMA_API_URL=http://localhost:11434/api/generate
GBSTUDIO_OLLAMA_EMBEDDINGS_URL=http://localhost:11434/api/embeddings
GBSTUDIO_OLLAMA_TAGS_URL=http://localhost:11434/api/tags
GBSTUDIO_COMFYUI_API_URL=http://localhost:8188

# Local Paths - Use current directory instead of /app
GBSTUDIO_PROJECT_FILES_PATH=./project_files
GBSTUDIO_WORKFLOW_TEMPLATE_PATH=./workflows/workflow_pixel_art.json
GBSTUDIO_TEMP_OUTPUTS_PATH=./temp_outputs
GBSTUDIO_VECTORSTORE_PATH=./vectorstore
GBSTUDIO_AGENT_MEMORY_PATH=./agent_memory
GBSTUDIO_GBSTUDIO_PROJECT_PATH=./project_files/MyGBCGame.gbsproj
GBSTUDIO_PROJECT_DOCS_DIR=./project_docs

# Agent Configuration
GBSTUDIO_PM_MODEL=llama3
GBSTUDIO_EMBEDDING_MODEL=nomic-embed-text
GBSTUDIO_DEFAULT_TIMEOUT=90

# Generation Parameters
GBSTUDIO_SPRITE_WIDTH=32
GBSTUDIO_SPRITE_HEIGHT=32
GBSTUDIO_NUM_FRAMES=8
GBSTUDIO_GENERATION_TIMEOUT=360

# Logging
LOG_LEVEL=INFO
LOG_DIR=./app/logs

# Frontend
FRONTEND_PATH=./frontend

# Security
API_KEYS_FILE=./app/secrets/api_keys.txt
