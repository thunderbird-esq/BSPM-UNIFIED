
# GBStudio Automation Hub - Backend Dockerfile
# Platform: Multi-arch (Intel Mac / Apple Silicon)
# Final Image Size: <600MB

FROM python:3.11-slim-bullseye AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Install PyTorch CPU-only
RUN pip install --no-cache-dir --user \
    torch==2.1.0 \
    torchvision==0.16.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install FAISS CPU
RUN pip install --no-cache-dir --user faiss-cpu==1.7.4

# Runtime stage
FROM python:3.11-slim-bullseye

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /usr/local

# Create non-root user
RUN useradd -m -u 1000 gbstudio && \
    chown -R gbstudio:gbstudio /app

# Copy backend code to /app/backend/
COPY --chown=gbstudio:gbstudio . /app/backend/

# Create runtime directories
RUN mkdir -p /app/temp_outputs /app/vectorstore /app/agent_memory /app/logs /app/frontend && \
    chown -R gbstudio:gbstudio /app

# Environment
ENV COMFYUI_DEVICE=cpu
ENV PYTORCH_ENABLE_MPS_FALLBACK=0
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

USER gbstudio

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD python -c "import requests; r = requests.get('http://localhost:8000/health', timeout=5); r.raise_for_status()" || exit 1

# Run from /app/backend/
WORKDIR /app/backend
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
