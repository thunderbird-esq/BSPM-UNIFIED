# GBStudio Automation Hub - Backend Dockerfile
# Platform: Intel Mac (x86_64) - macOS Ventura 13.x
# Target: Docker Desktop 4.25+ with Rosetta 2
# Final Image Size: <600MB

# ============================================================================
# Stage 1: Builder - Install dependencies with build tools
# ============================================================================
FROM python:3.11-slim-bullseye AS builder

# Note: This image is designed for x86_64 but can be built on Apple Silicon
# using Docker Desktop with Rosetta 2 emulation (--platform linux/amd64)

WORKDIR /app

# Install build dependencies for Python packages
# gcc: Required for compiling native extensions (faiss, numpy)
# g++: Required for C++ extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for Docker layer caching
COPY requirements.txt .

# Install Python dependencies to user directory (isolated from system)
# --no-cache-dir: Don't cache packages (saves ~100MB)
# --user: Install to ~/.local (can be copied to runtime stage)
RUN pip install --no-cache-dir --user -r requirements.txt

# Install PyTorch CPU-only build (critical for Intel Mac)
# Index URL points to CPU-only wheels (~200MB smaller than CUDA builds)
RUN pip install --no-cache-dir --user \
    torch==2.1.0 \
    torchvision==0.16.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install FAISS CPU-only build
# faiss-cpu: No GPU dependencies, optimized for CPU vector search
RUN pip install --no-cache-dir --user faiss-cpu==1.7.4


# ============================================================================
# Stage 2: Runtime - Minimal production image
# ============================================================================
FROM python:3.11-slim-bullseye

WORKDIR /app

# Copy Python packages from builder stage
# This includes all dependencies from requirements.txt + torch + faiss
COPY --from=builder /root/.local /usr/local

# Create non-root user for security
# UID 1000 matches typical macOS user UID for file permission compatibility
RUN useradd -m -u 1000 gbstudio && \
    chown -R gbstudio:gbstudio /app

# Copy application code with correct ownership
COPY --chown=gbstudio:gbstudio . .

# Create required directories for runtime
RUN mkdir -p /app/temp_outputs /app/vectorstore /app/agent_memory && \
    chown -R gbstudio:gbstudio /app/temp_outputs /app/vectorstore /app/agent_memory

# Environment variables for CPU-only execution
ENV COMFYUI_DEVICE=cpu
ENV PYTORCH_ENABLE_MPS_FALLBACK=0
ENV PYTHONUNBUFFERED=1

# Switch to non-root user
USER gbstudio

# Expose API port
EXPOSE 8000

# Health check with model verification
# start-period=300s: Allow 5 minutes for first-run model downloads
# interval=30s: Check every 30 seconds after startup
# timeout=10s: Fail if health check takes >10s
# retries=3: Mark unhealthy after 3 consecutive failures
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD python -c "import requests; \
    r = requests.get('http://localhost:8000/health', timeout=5); \
    r.raise_for_status(); \
    services = r.json().get('services', {}); \
    ollama = services.get('ollama', {}); \
    assert ollama.get('status') == 'healthy', 'Ollama not healthy'; \
    assert ollama.get('models_ok', False), 'Required models not loaded'" || exit 1

# Run application with uvicorn
# --host 0.0.0.0: Listen on all interfaces (required for Docker networking)
# --port 8000: Standard HTTP port
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
