{
  "name": "Save/Load System",
  "description": "Save and load game state using persistent variables",
  "category": "logic",
  "events": [
    {
      "id": "{{event_id_1}}",
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "{{save_message}}"
        ]
      }
    },
    {
      "id": "{{event_id_2}}",
      "command": "EVENT_SAVE_DATA",
      "args": {
        "saveSlot": 0
      }
    },
    {
      "id": "{{event_id_3}}",
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Game saved successfully!"
        ]
      }
    }
  ],
  "variables": {
    "save_message": {
      "type": "string",
      "description": "Message to show before saving",
      "required": false,
      "default": "Saving game..."
    }
  }
}
