# GBStudio Automation Hub - Frontend Configuration
# Copy this file to .env.local and configure for your environment

# ============================================================================
# Backend API Configuration
# ============================================================================

# Backend API Base URL
# Default: http://localhost:8000
# Production: https://your-backend-domain.com
API_BASE_URL=http://localhost:8000

# API Key for authenticated endpoints (optional for development)
# Required for: /api/v1/execute, /api/v1/admin/kb/upload
# Get your API key from: /app/secrets/api_keys.txt (in backend container)
# Example: test-api-key-49a07b1d54218c8df192114e5eb35dcd
API_KEY=

# ============================================================================
# External Services Configuration
# ============================================================================

# ComfyUI Service Host
# Default: localhost:8188
# Used for: WebSocket connections, image generation status
COMFYUI_HOST=localhost:8188

# Ollama Service Host
# Default: localhost:11434
# Used for: Service health monitoring
OLLAMA_HOST=localhost:11434

# ============================================================================
# Application Configuration
# ============================================================================

# Environment mode
# Options: development, production
# Default: development
NODE_ENV=development

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# API Request Timeout (milliseconds)
# Default: 30000 (30 seconds)
# API_TIMEOUT=30000

# API Retry Attempts
# Default: 3
# API_RETRY_ATTEMPTS=3

# WebSocket Reconnect Delay (milliseconds)
# Default: 5000 (5 seconds)
# WS_RECONNECT_DELAY=5000

# ============================================================================
# Usage Instructions
# ============================================================================

# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Edit .env.local with your values
#
# 3. Configuration is loaded via index.html script injection
#
# 4. Verify configuration in browser console:
#    import { getConfig } from './src/utils/api.js';
#    console.log(getConfig());
#
# 5. For production deployment, set these values in your hosting platform
#    or use a build-time environment variable injection system
